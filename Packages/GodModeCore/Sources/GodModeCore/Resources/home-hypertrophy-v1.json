{
  "schemaVersion": 1,
  "id": "home-hypertrophy",
  "name": "Four-Day Home Hypertrophy",
  "revision": 1,
  "reviewNotice": "Day 1 follows the supplied program. Day 2–4 targets are editable development assumptions awaiting program review. Confirm a suitable load for every exercise; the available 10 kg dumbbells may not suit every movement.",
  "exercises": [
    {
      "id": "bench-press",
      "name": "Dumbbell Bench Press",
      "equipment": [
        "dumbbells",
        "bench"
      ],
      "safetyNote": "Secure the bench and use a controllable load. Stop if the movement causes pain."
    },
    {
      "id": "incline-press",
      "name": "Incline Dumbbell Press",
      "equipment": [
        "dumbbells",
        "bench"
      ],
      "safetyNote": "Lock the bench incline before use and keep the movement controlled."
    },
    {
      "id": "shoulder-press",
      "name": "Dumbbell Shoulder Press",
      "equipment": [
        "dumbbells",
        "bench"
      ],
      "safetyNote": "Choose a load you can control without leaning back excessively."
    },
    {
      "id": "lateral-raise",
      "name": "Dumbbell Lateral Raise",
      "equipment": [
        "dumbbells"
      ],
      "safetyNote": "Use lighter equipment or a regression if 10 kg cannot be controlled."
    },
    {
      "id": "triceps-extension",
      "name": "Overhead Dumbbell Triceps Extension",
      "equipment": [
        "dumbbell"
      ],
      "safetyNote": "Use a comfortable range and a secure grip; choose a lighter load when needed."
    },
    {
      "id": "close-push-up",
      "name": "Close-Grip Push-Up",
      "equipment": [
        "floor"
      ],
      "safetyNote": "End the set when safe technique cannot be maintained; an incline variation is available."
    },
    {
      "id": "goblet-squat",
      "name": "Goblet Squat",
      "equipment": [
        "dumbbell"
      ],
      "safetyNote": "Use a comfortable range and stable footing."
    },
    {
      "id": "split-squat",
      "name": "Bulgarian Split Squat",
      "equipment": [
        "dumbbells",
        "bench"
      ],
      "safetyNote": "Ensure the bench is stable. Use a floor split squat if balance or setup is unsuitable."
    },
    {
      "id": "rdl",
      "name": "Dumbbell Romanian Deadlift",
      "equipment": [
        "dumbbells"
      ],
      "safetyNote": "Keep the load controlled and use a comfortable hip-hinge range."
    },
    {
      "id": "reverse-lunge",
      "name": "Reverse Lunge",
      "equipment": [
        "dumbbells"
      ],
      "safetyNote": "Clear the floor and use support or a bodyweight variation when needed."
    },
    {
      "id": "calf-raise",
      "name": "Calf Raise",
      "equipment": [
        "dumbbells"
      ],
      "safetyNote": "Use the floor and stable support; do not balance on unsecured objects."
    },
    {
      "id": "dead-bug",
      "name": "Dead Bug",
      "equipment": [
        "floor"
      ],
      "safetyNote": "Keep the movement controlled and use a comfortable range."
    },
    {
      "id": "side-plank",
      "name": "Side Plank",
      "equipment": [
        "floor"
      ],
      "safetyNote": "Use a bent-knee variation if needed and stop when form deteriorates."
    },
    {
      "id": "one-arm-row",
      "name": "One-Arm Dumbbell Row",
      "equipment": [
        "dumbbell",
        "bench"
      ],
      "safetyNote": "Support yourself on a stable bench and avoid twisting to lift the load."
    },
    {
      "id": "renegade-row",
      "name": "Renegade Row",
      "equipment": [
        "dumbbells",
        "floor"
      ],
      "safetyNote": "Do not support body weight on dumbbells that can roll. Substitute a supported row when the setup is unstable."
    },
    {
      "id": "rear-delt-fly",
      "name": "Rear-Delt Fly",
      "equipment": [
        "dumbbells"
      ],
      "safetyNote": "Use a lighter load or regression when needed; avoid swinging."
    },
    {
      "id": "curl",
      "name": "Dumbbell Curl",
      "equipment": [
        "dumbbells"
      ],
      "safetyNote": "Use a controlled range without swinging the torso."
    },
    {
      "id": "hammer-curl",
      "name": "Hammer Curl",
      "equipment": [
        "dumbbells"
      ],
      "safetyNote": "Choose a load that permits controlled reps without wrist discomfort."
    },
    {
      "id": "supported-row",
      "name": "Chest-Supported Dumbbell Row",
      "equipment": [
        "dumbbells",
        "bench"
      ],
      "safetyNote": "Lock the incline and ensure bench stability. This replaces improvised door or towel anchors."
    },
    {
      "id": "thruster",
      "name": "Dumbbell Thruster",
      "equipment": [
        "dumbbells"
      ],
      "safetyNote": "Use a controllable load and clear overhead space; separate squat and press if needed."
    },
    {
      "id": "incline-fly",
      "name": "Incline Dumbbell Fly",
      "equipment": [
        "dumbbells",
        "bench"
      ],
      "safetyNote": "Use a comfortable shoulder range and lighter load if needed; substitute a press if the movement is uncomfortable."
    },
    {
      "id": "rdl-row",
      "name": "Romanian Deadlift to Row",
      "equipment": [
        "dumbbells"
      ],
      "safetyNote": "Each rep combines a controlled hinge and row. Use separate movements if technique deteriorates."
    },
    {
      "id": "front-raise",
      "name": "Dumbbell Front Raise",
      "equipment": [
        "dumbbells"
      ],
      "safetyNote": "Use lighter equipment or a regression if 10 kg cannot be controlled."
    },
    {
      "id": "curl-press",
      "name": "Curl-to-Press Complex",
      "equipment": [
        "dumbbells"
      ],
      "safetyNote": "Choose the load for the weaker movement and avoid momentum."
    },
    {
      "id": "incline-push-up",
      "name": "Incline Push-Up",
      "equipment": [
        "bench"
      ],
      "safetyNote": "Use a locked, stable bench that cannot slide."
    },
    {
      "id": "march",
      "name": "Controlled March",
      "equipment": [
        "floor"
      ],
      "safetyNote": "Use stable footing, comfortable pace and clear floor space."
    }
  ],
